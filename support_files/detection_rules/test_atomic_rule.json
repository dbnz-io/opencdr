{
  "rule_id": "100_identity_console_login",
  "rule_kind": "correlation",
  "enabled": true,
  "severity": "CRITICAL",
  "description": "Suspicious login followed by privilege escalation actions",

  "group_by": "actor.user_name",

  "time_window_seconds": 900,
  "threshold": 1,

  "sequence": [
    {
      "signal_rule_id": "002_identity_console_login_no_mfa_success"
    }
  ],

  "notify": true,
  "response_module": "disable_user",

  "playbook": "Possible account takeover — disable user and review activity."
}
